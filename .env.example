# Offline startup needs no .env. Copy only if absent; never overwrite your secrets.
# Existing OS environment variables take precedence. Never commit .env.
MRAG_MODE=offline
MRAG_HOST=127.0.0.1
MRAG_PORT=8010
MRAG_LOG_LEVEL=INFO
MRAG_MAX_DOCUMENT_BYTES=2097152
MRAG_MAX_PDF_BYTES=20971520
MRAG_MAX_PDF_PAGES=200
# 可切换阶段性入库白名单；必须位于 data/manifests 目录，默认使用基础中文清单。
MRAG_INGESTION_MANIFEST=data/manifests/ingestion_chinese_md.jsonl
# 网页上传元数据清单。文件由服务端原子更新，不应提交到 Git。
MRAG_RUNTIME_UPLOAD_MANIFEST=data/manifests/runtime_uploads.jsonl

# Dedicated database only. Set password locally, never in chat or shell history.
# MRAG_POSTGRES_DSN="host=127.0.0.1 port=5432 dbname=multimodal_rag user=multimodal_rag_app password=YOUR_PASSWORD"
MRAG_POSTGRES_DSN=
# Beijing workspace. One shared key for chat/vision/embedding/rerank is sufficient.
MRAG_BAILIAN_WORKSPACE_ID=
MRAG_BAILIAN_API_KEY=
# Both api mode AND this switch AND explicit CLI confirmation are required for live checks.
MRAG_API_ENABLED=false
MRAG_PARSER_API_KEY=
MRAG_CHAT_API_KEY=
MRAG_VISION_API_KEY=
MRAG_EMBEDDING_API_KEY=
MRAG_RERANK_API_KEY=
MRAG_CHAT_MODEL=qwen-plus
MRAG_VISION_MODEL=qwen3-vl-plus
MRAG_EMBEDDING_MODEL=text-embedding-v4
MRAG_EMBEDDING_DIMENSIONS=1024
MRAG_RERANK_MODEL=qwen3-rerank
# Blank model URLs derive from the workspace above. Rerank has a different API path!
MRAG_CHAT_BASE_URL=
MRAG_VISION_BASE_URL=
MRAG_EMBEDDING_BASE_URL=
MRAG_RERANK_BASE_URL=
MRAG_PARSER_BASE_URL=https://mineru.net/api/v4
MRAG_PARSER_MODEL=vlm
MRAG_API_TIMEOUT_SECONDS=45
MRAG_API_GET_RETRIES=2
MRAG_API_MAX_OUTPUT_TOKENS=1024
# Exact allowlist for signed upload / result download. No auth header is forwarded.
MRAG_PARSER_TRANSFER_HOSTS=mineru.oss-cn-shanghai.aliyuncs.com,cdn-mineru.openxlab.org.cn
# HTTPS proxy for reaching Bailian/MinerU behind corporate firewalls. Blank = direct connection.
# MRAG_HTTPS_PROXY=http://127.0.0.1:7890
MRAG_HTTPS_PROXY=
